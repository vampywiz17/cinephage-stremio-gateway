CINEPHAGE_URL=http://cinephage:3000
CINEPHAGE_API_KEY=replace-with-a-cinephage-api-key
BRIDGE_SECRET=replace-with-at-least-32-random-characters
BRIDGE_VERSION=0.4.0

# Maps paths reported by Cinephage to paths visible inside this container.
# JSON is recommended. The longest matching source prefix wins.
PATH_MAPPINGS={"/movies":"/media/movies","/tv":"/media/tv"}

PORT=8090
PUBLIC_URL=http://localhost:8090
ADDON_TOKEN=
LIBRARY_CACHE_TTL_SECONDS=30
SERIES_CACHE_TTL_SECONDS=30
STREAM_TOKEN_TTL_SECONDS=21600
CINEPHAGE_TIMEOUT_SECONDS=15
LOG_LEVEL=info
